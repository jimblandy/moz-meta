#!/usr/bin/env bash

set -eux

changeset=$1

RESULTS=$HOME/moz/webgpu-cts-results
if ! [ -d "$RESULTS" ]; then
    echo "Results directory doesn't exist: $RESULTS" >&2
    exit 1
fi   

moz webgpu-cts-fetch "$changeset"

moz-webgpu-cts update-expected                                  \
               --glob "${RESULTS}/$changeset/**/wptreport.json" \
               --implementation-status backlog                  \
               --on-skip-only ignore

# We shouldn't need `--on-skip-only`, all tests should run, boo
moz-webgpu-cts update-backlog promote perma-passing
